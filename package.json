{
  "name": "lzyrecipe",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "mobile"
  ],
  "scripts": {
    "start": "bun run --filter lzyrecipe-mobile start",
    "dev": "bun run --filter lzyrecipe-mobile start",
    "android": "bun run --filter lzyrecipe-mobile android",
    "ios": "bun run --filter lzyrecipe-mobile ios",
    "web": "bun run --filter lzyrecipe-mobile web",
    "lint": "bun run --filter lzyrecipe-mobile lint",
    "typecheck": "bun run --filter lzyrecipe-mobile typecheck",
    "doctor": "bunx expo-doctor@latest",
    "covers": "node scripts/generate-covers.mjs",
    "covers:photos": "node scripts/fetch-covers.mjs"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
