{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "萌厨食光",
  "version": "0.1.0",
  "identifier": "com.lzyrecipe.recipes",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "萌厨食光",
        "width": 1024,
        "height": 768,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "shortDescription": "萌厨食光 · 轻松规划每一天的美味",
    "longDescription": "萌厨食光，卡通风格中餐菜谱应用，收藏菜谱、规划周菜单、好好吃饭。"
  }
}
