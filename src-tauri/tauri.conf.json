{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "lzyRecipe",
  "version": "0.1.0",
  "identifier": "com.lzyrecipe.recipes",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "菜谱应用",
        "width": 1024,
        "height": 768,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "shortDescription": "菜谱收藏与管理应用",
    "longDescription": "一款简洁优雅的菜谱收藏与管理应用，帮助用户发现、收藏、分享美味食谱。"
  }
}
